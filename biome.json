{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": false,
        "clientKind": "git",
        "useIgnoreFile": false
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/.next/**",
            "!**/node_modules/**",
            "!**/.pnp/**",
            "!**/.husky/**",
            "!**/package-lock.json",
            "!**/yarn.lock",
            "!**/pnpm-lock.yaml"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    }
}
